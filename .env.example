# ═══════════════════════════════════════════════════════════
# Sakila Payment Gateway - variables de entorno (DEMO)
# Copie este archivo a .env y ajuste los valores.
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=sakila
POSTGRES_PASSWORD=sakila
POSTGRES_DB=sakila_gateway
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sakila:sakila@localhost:5432/sakila_gateway?schema=public

# ── Backend / API ───────────────────────────────────────────
PORT=3000
BACKEND_PORT=3000
NODE_ENV=development

# JWT: use valores largos y aleatorios fuera de la demo.
JWT_SECRET=demo-jwt-secret-change-me-123456
JWT_REFRESH_SECRET=demo-refresh-secret-change-me-654321
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Ejecutar seed idempotente al arrancar el contenedor backend.
RUN_SEED=true

# ── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=/api
